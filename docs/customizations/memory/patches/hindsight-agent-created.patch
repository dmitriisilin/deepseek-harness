+function applyPersonal(ctx: DshContext, hooks: ReturnType<typeof createDshHooks>): void {
+  if (!process.env.HINDSIGHT_BANK_ID) throw new Error("Personal Hindsight memory needs a dedicated bank");
+  const { cfg, bankId, client } = resolveHostMemory(HARNESS, process.cwd());
+  if (cfg.disabled || bankId !== process.env.HINDSIGHT_BANK_ID) {
+    throw new Error("Personal Hindsight memory resolved to an unexpected bank");
+  }
+  let profile = "";
+  let nextRefresh = 0;
+  function refreshProfile(): void {
+    if (!readPersonal || Date.now() < nextRefresh) return;
+    nextRefresh = Date.now() + 60_000;
+    void client.getMentalModel("personal-profile", { timeoutMs: 2000 }).then(model => {
+      if (model && typeof model === "object" && "content" in model && typeof model.content === "string") {
+        profile = model.content.trim().slice(0, 1200);
+      }
+    }).catch(() => {});
+  }
+  ctx.on("agent/created", ({ agent }) => {
+    if (allowsPersonalMemory(agent)) refreshProfile();
+    return undefined;
+  });
+  ctx.on("agent/pre-step", async ({ agent, signal }, next) => {
+    const decision = await next();
+    if (!readPersonal || !allowsPersonalMemory(agent) || signal.aborted || decision.kind !== "enter" || !promptOf(decision.messages)) return decision;
+    refreshProfile();
+    if (!profile || profile === lastInjectedText(dshSessionEvents(agent.session))) return decision;
+    return { ...decision, messages: [...decision.messages, injectionMessage(profile)] };
+  }, { prepend: true });
+  ctx.on("agent/turn-stopping", ({ agent }) => {
+    if (allowsPersonalMemory(agent)) return hooks.turnStopping({ agent });
+  });
+  ctx.on("agent/disposed", hooks.disposed);
+  if (!readPersonal) return;
+  ctx.inject(["tools"], ({ tools }) => {
+    tools.register({
+      name: "personal_memory_search",
+      description: "Search your personal memory for relevant past facts and discussions.",
+      parameters: { type: "object", properties: { query: { type: "string" } }, required: ["query"], additionalProperties: false },
+      output: { schema: { type: "string" }, render: (_args: unknown, value: string) => [{ type: "text", text: value }] },
+      async execute(args: { query: string }, exec: DshToolRunContext): Promise<string> {
+        if (!exec.agent || !allowsPersonalMemory(exec.agent)) throw new Error("Personal memory is disabled");
+        const observations = await client.recallObservations(args.query, { timeoutMs: 4000 });
+        return observations.join("\n").slice(0, 6000) || "No relevant personal memories found.";
+      },
+    }, { when: ({ agent }) => allowsPersonalMemory(agent) });
+  });
+}
+
 export default { name, inject, apply };
